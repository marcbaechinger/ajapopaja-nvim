# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Lua ---
# If you use Luarocks for dependencies
lua_modules/
*.rock
*.rockspec

# --- Neovim / Editor ---
# Swap files and backup files
*.swp
*.swo
*.swn
*.bak
*.undo
.netrwhist

# Tags files (generated by ctags/gutentags)
tags
tags.lock
tags.temp

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Plugin Specific ---
# If your plugin generates logs during development
*.log
# --- Neovim Remote Plugin Specific ---
# Ignore the generated rplugin manifest if you happen to run 
# UpdateRemotePlugins while inside this directory in some environments
rplugin.vim

# Ignore local history/config if symlinked or created during testing
.ajapopaja/
history_storage/

# --- Testing Artifacts ---
# If you use 'plenary.nvim' for Lua testing, it sometimes leaves artifacts
.repro/

# --- Documentation ---
# Neovim help tags file (generated by :helptags)
# Usually, we don't commit 'tags' inside the 'doc/' folder 
# as they are generated by the user's plugin manager.
doc/tags
